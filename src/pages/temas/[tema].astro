---
import TemaPagina from '../../views/TemaPagina.astro';
import { escritosOrdenados, temasUsados, slugTema } from '../../utils';

export async function getStaticPaths() {
  const todos = await escritosOrdenados('es');
  return (await temasUsados('es')).map((t) => ({
    params: { tema: t.slug },
    props: { nombre: t.tema, lista: todos.filter((e) => slugTema(e.data.tema) === t.slug) },
  }));
}
const { nombre, lista } = Astro.props;
---
<TemaPagina lang="es" slug={Astro.params.tema} nombre={nombre} lista={lista} />
