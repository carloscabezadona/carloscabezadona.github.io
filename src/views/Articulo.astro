---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { relacionados, traduccion, mesAnio, fechaLarga, colorTema, slugTema, slugDe, minutosLectura, url, type Escrito } from '../utils';
import { RUTAS, rutaArticulo, rutaTema, T, type Lang } from '../i18n';
import { SITE_TITLE, EMAIL } from '../consts';

interface Props { entrada: Escrito; lang: Lang }
const { entrada, lang } = Astro.props;
const t = T[lang];
const otro: Lang = lang === 'es' ? 'en' : 'es';
const { Content } = await render(entrada);
const { titulo, fecha, tema, descripcion, nota, imagen, imagenAlt, imagenCredito } = entrada.data;
const minutos = minutosLectura(entrada);
const otros = await relacionados(entrada, 2);
const version = await traduccion(entrada);
const alt = version ? rutaArticulo(otro, slugDe(version)) : RUTAS.analisis[otro];

const enlace = new URL(Astro.url.pathname, Astro.site).toString();
const e = encodeURIComponent;
const compartir = {
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${e(enlace)}`,
  x: `https://x.com/intent/post?url=${e(enlace)}&text=${e(titulo)}`,
  email: `mailto:?subject=${e(titulo)}&body=${e(`${descripcion}\n\n${enlace}`)}`,
};
---
<Base lang={lang} alt={alt} title={titulo} description={descripcion} type="article" publishedTime={fecha} image={imagen} section={tema}>
  <div class="progreso" aria-hidden="true"><span></span></div>
  <article style={`--tc:${colorTema(tema)}`}>
    <div class="art-meta">
      <a class="art-tema" href={url(rutaTema(lang, slugTema(tema)))}>{tema.toUpperCase()}</a>
      &nbsp;·&nbsp; <time datetime={fecha.toISOString()}>{mesAnio(fecha, lang)}</time>
      &nbsp;·&nbsp; {minutos} {t.minLectura}
    </div>
    <h1>{titulo}</h1>
    <p class="art-dek">{descripcion}</p>
    {nota && <p class="art-nota">{nota}</p>}
    {version && (
      <p class="art-idioma"><a href={url(alt)} hreflang={otro}>{t.traduccion} →</a></p>
    )}
    <svg class="leafrule" width="46" height="14" viewBox="0 0 46 14" fill="none" aria-hidden="true">
      <path d="M0 7h16M30 7h16" stroke="#3D6B4A" stroke-width="1" opacity=".4"/>
      <path d="M23 13c0-4 1.6-6.6 4.6-7.6C27.1 10 25.5 12 23 13Z" fill="#3D6B4A" opacity=".7"/>
      <path d="M23 13c0-4-1.6-6.6-4.6-7.6C18.9 10 20.5 12 23 13Z" fill="#3D6B4A" opacity=".4"/>
    </svg>
    {imagen && (
      <figure class="art-img">
        <img src={url(imagen)} alt={imagenAlt ?? ''} loading="eager" />
        {imagenCredito && <figcaption>{imagenCredito}</figcaption>}
      </figure>
    )}
    <div class="body">
      <Content />
    </div>

    <div class="art-pie">
      <div class="compartir">
        <span>{t.compartir}</span>
        <a href={compartir.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href={compartir.x} target="_blank" rel="noopener">X</a>
        <a href={compartir.email}>Email</a>
        <button type="button" class="copiar" data-url={enlace} data-ok={t.copiado} data-ko={t.noCopiado}>{t.copiar}</button>
      </div>

      <div class="autor">
        <div class="autor-mono" aria-hidden="true">C<svg viewBox="0 0 24 24" fill="none"><path d="M12 22c0-8 3-13 9-15-1 9-4 13-9 15Z" fill="#3D6B4A" opacity=".85"/><path d="M12 22C12 14 9 9 3 7c1 9 4 13 9 15Z" fill="#3D6B4A" opacity=".45"/></svg>C</div>
        <div>
          <div class="autor-nombre">{SITE_TITLE}</div>
          <p>{t.autorBio(fechaLarga(fecha, lang))}</p>
          <p class="autor-links"><a href={url(RUTAS.sobre[lang])}>{t.nav.sobre}</a> · <a href={`mailto:${EMAIL}`}>{t.nav.contacto}</a> · <a href={url(RUTAS.rss[lang])}>RSS</a></p>
        </div>
      </div>
    </div>
  </article>

  {otros.length > 0 && (
    <div class="band warm">
      <div class="band-inner">
        <h2 class="eyebrow">{t.sigue}</h2>
        <div class="sigue">
          {otros.map((o) => (
            <a class="sigue-card" href={url(rutaArticulo(lang, slugDe(o)))} style={`--tc:${colorTema(o.data.tema)}`}>
              {o.data.imagen && <img src={url(o.data.imagen)} alt="" loading="lazy" />}
              <span class="tema">{o.data.tema.toUpperCase()}</span>
              <span class="t">{o.data.titulo}</span>
              <span class="m">{mesAnio(o.data.fecha, lang)} · {minutosLectura(o)} {t.min}</span>
            </a>
          ))}
        </div>
        <div class="back"><a href={url(RUTAS.analisis[lang])}>{t.volver}</a></div>
      </div>
    </div>
  )}

  <script>
    const barra = document.querySelector<HTMLElement>('.progreso span');
    const art = document.querySelector('article');
    const actualizar = () => {
      if (!barra || !art) return;
      const r = art.getBoundingClientRect();
      const total = r.height - window.innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
      barra.style.transform = `scaleX(${p})`;
    };
    addEventListener('scroll', actualizar, { passive: true });
    addEventListener('resize', actualizar);
    actualizar();

    document.querySelectorAll<HTMLButtonElement>('.copiar').forEach((b) => {
      const original = b.textContent;
      b.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.dataset.url ?? location.href);
          b.textContent = b.dataset.ok ?? '';
        } catch {
          b.textContent = b.dataset.ko ?? '';
        }
        setTimeout(() => (b.textContent = original), 2000);
      });
    });
  </script>
</Base>
