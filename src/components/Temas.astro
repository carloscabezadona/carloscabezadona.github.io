---
import { temasUsados, colorTema, url } from '../utils';
import { RUTAS, rutaTema, T, type Lang } from '../i18n';
interface Props { lang: Lang; activo?: string }
const { lang, activo } = Astro.props;
const temas = await temasUsados(lang);
---
<nav class="temas" aria-label={lang === 'en' ? 'Topics' : 'Temas'}>
  <a href={url(RUTAS.analisis[lang])} class:list={{ on: !activo }}>{T[lang].todos}</a>
  {temas.map((t) => (
    <a href={url(rutaTema(lang, t.slug))} class:list={{ on: activo === t.slug }} style={`--tc:${colorTema(t.tema)}`}>
      {t.tema}
    </a>
  ))}
</nav>
