---
import { mesAnio, colorTema, slugTema, slugDe, minutosLectura, url, type Escrito } from '../utils';
import { rutaArticulo, rutaTema, T, type Lang } from '../i18n';
interface Props { entrada: Escrito; lang: Lang }
const { entrada: e, lang } = Astro.props;
const t = T[lang];
const href = url(rutaArticulo(lang, slugDe(e)));
---
<div class:list={['destacado', { 'sin-img': !e.data.imagen }]} style={`--tc:${colorTema(e.data.tema)}`}>
  {e.data.imagen && (
    <a class="d-img" href={href} tabindex="-1" aria-hidden="true">
      <img src={url(e.data.imagen)} alt="" loading="eager" />
    </a>
  )}
  <div class="d-txt">
    <div class="d-kicker">
      <span>{t.ultimo}</span>
      <a class="tema" href={url(rutaTema(lang, slugTema(e.data.tema)))}>{e.data.tema.toUpperCase()}</a>
    </div>
    <h3><a href={href}>{e.data.titulo}</a></h3>
    <p class="dek">{e.data.descripcion}</p>
    <div class="d-meta">{mesAnio(e.data.fecha, lang)} &nbsp;·&nbsp; {minutosLectura(e)} {t.minLectura}</div>
    <a class="d-more" href={href}>{t.leer} <span aria-hidden="true">→</span></a>
  </div>
</div>
