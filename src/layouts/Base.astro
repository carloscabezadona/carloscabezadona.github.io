---
import '../styles/global.css';
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, LINKEDIN, GOATCOUNTER } from '../consts';
import { url } from '../utils';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  image?: string;
  section?: string;
}

const { title, description = SITE_DESCRIPTION, type = 'website', publishedTime, image, section } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(image ?? '/og.png'), Astro.site);
const inicio = new URL(url('/'), Astro.site).toString();

// Datos estructurados (schema.org) para buscadores.
const autor = {
  '@type': 'Person',
  name: SITE_TITLE,
  url: new URL(url('/sobre-mi/'), Astro.site).toString(),
  jobTitle: 'Jurista, asuntos europeos',
  sameAs: [LINKEDIN],
};
const jsonLd = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      image: [ogImage.toString()],
      datePublished: publishedTime?.toISOString(),
      inLanguage: 'es',
      articleSection: section,
      mainEntityOfPage: canonical.toString(),
      author: autor,
      publisher: autor,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE_TITLE,
      description: SITE_DESCRIPTION,
      url: inicio,
      inLanguage: 'es',
      author: autor,
    };
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  <link rel="sitemap" href={url('/sitemap-index.xml')} />
  <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={url('/rss.xml')} />

  <!-- Open Graph / Twitter -->
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE_TITLE} />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:title" content={title ?? SITE_TITLE} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  {!image && <meta property="og:image:width" content="1200" />}
  {!image && <meta property="og:image:height" content="630" />}
  {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title ?? SITE_TITLE} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {section && <meta property="article:section" content={section} />}
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  {GOATCOUNTER && (
    <script is:inline data-goatcounter={`https://${GOATCOUNTER}.goatcounter.com/count`} async src="https://gc.zgo.at/count.js"></script>
  )}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Karla:wght@300;400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <Topbar />
  <slot />
  <Footer />
</body>
</html>
